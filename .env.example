# Brevo contact sync and email delivery are disabled until an API key, verified sender and test recipient are ready.
BREVO_INTEGRATION_ENABLED=false
BREVO_ENVIRONMENT=development
# Guards all production Brevo writes and sends until launch approval.
BREVO_PRODUCTION_SEND_ENABLED=false

# Keep the real value in local/hosting environment variables. Never commit it.
BREVO_API_KEY=

# A separate, high-entropy secret used only to authenticate Brevo webhook calls.
# Configure Brevo to send it as: Authorization: Bearer <secret>
BREVO_WEBHOOK_ENABLED=false
BREVO_WEBHOOK_SECRET=

BREVO_SENDER_NAME=Anderseed Consulting
BREVO_SENDER_EMAIL=

# Comma-separated allowlist used in development/test to prevent accidental sends.
BREVO_TEST_RECIPIENTS=

# Purpose-based lists created in the Anderseed Lifecycle folder.
BREVO_LIST_ALL_LEADS_ID=8
BREVO_LIST_ROADMAP_ID=9
BREVO_LIST_ASSESSMENT_ID=10
BREVO_LIST_APPLICATIONS_ID=11
BREVO_LIST_CONSULTATIONS_ID=12
BREVO_LIST_EVENTS_ID=13
BREVO_LIST_CUSTOMERS_ID=14

# Added in later phases after the templates and final download URL exist.
BREVO_ROADMAP_TEMPLATE_ID=1
BREVO_DOUBLE_OPT_IN_TEMPLATE_ID=
BREVO_ROADMAP_URL=
BREVO_ROADMAP_ASSET_STATUS=placeholder
